<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nurturing.Mapper.WeeklyAverageDataMapper">

    <resultMap id="WeeklyResultMap" type="com.nurturing.entity.WeeklyAverageData">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="dataType" column="data_type"/>
        <result property="averageValue" column="average_value"/>
        <result property="weekStartDate" column="week_start_date"/>
        <result property="yearValue" column="year_value"/>
    </resultMap>

    <select id="selectByWeekRange" resultMap="WeeklyResultMap">
        SELECT
            average_value,
            week_start_date,
            year_value
        FROM weekly_average_data
        WHERE
            user_id = #{userId}
          AND data_type = #{dataType}
          AND week_start_date BETWEEN #{startWeek} AND #{endWeek}
        ORDER BY week_start_date ASC
    </select>
</mapper>