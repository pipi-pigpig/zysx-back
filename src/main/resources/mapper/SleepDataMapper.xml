<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nurturing.Mapper.SleepDataMapper">

    <resultMap id="SleepDataResultMap" type="com.nurturing.entity.SleepData">
        <result property="sleepData" column="sleep_data"/>
        <result property="recordTime" column="record_time"/>
    </resultMap>

    <select id="selectRawSleepByDate" resultMap="SleepDataResultMap">
        SELECT sleep_data, record_time
        FROM sleep_data
        WHERE user_id = #{userId}
          AND DATE(record_time) = #{date}
        ORDER BY record_time ASC
    </select>
</mapper>
